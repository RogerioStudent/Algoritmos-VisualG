Algoritmo "N13_par_impar"
// Disciplina   : Linguagem e Lógica de Programação
// Professor   : Gabriel Sena
Var
// Seção de Declarações das variáveis
   n: inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc...
   escreva("Numero: ")
   leia(n)
   se n % 2 = 0 entao
      escreval("Par")
   senao
      escreval("Impar")
   fimse
Fimalgoritmo