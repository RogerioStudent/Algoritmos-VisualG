Algoritmo "N7_media_aritmetica"
// Disciplina   : Linguagem e Lógica de Programação
// Professor   : Gabriel Sena
Var
n1, n2, n3, media: real

Inicio

   leia(n1)
   escreva("Nota 2: ")
   leia(n2)
   escreva("Nota 3: ")
   leia(n3)
   media <- (n1 + n2 + n3) / 3
   escreval("Media: ", media)
Fimalgoritmo