algoritmo "N5_retangulo"
// Disciplina   : Linguagem e Lógica de Programação
// Professor   : Gabriel Sena

var
   largura, comprimento: real
inicio
   escreva("Largura: ")
   leia(largura)
   escreva("Comprimento: ")
   leia(comprimento)
   escreval("Area: ", largura * comprimento)
   escreval("Perimetro: ", 2 * (largura + comprimento))
fimalgoritmo